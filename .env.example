# Native binaries use PORT (API default 14000, demo default 14001).
# Compose uses these loopback-only host ports; container ports stay fixed.
API_PORT=14000
DEMO_PORT=14001
KEYBANK_STORE=redis
REDIS_ADDR=redis:6379
MAX_TTL=168h
AUTO_HIDE_SECONDS=60

# Browser-facing API URL, including /api/v1. Local HTTP development:
API_BASE_URL=http://localhost:14000/api/v1
# For production with the Caddy profile, change API_BASE_URL to /api/v1.
# For a separate API domain, use its HTTPS URL and add the demo's exact origin.
CORS_ALLOWED_ORIGINS=http://localhost:14001,http://127.0.0.1:14001

# Redis remains private and memory-only. New creates fail when full.
REDIS_MAXMEMORY=256mb
SITE_ADDRESS=notes.example.com
# COMPOSE_PROFILES=caddy
