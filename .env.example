# KeyBank app configuration
# The app is published on 127.0.0.1:${PORT} so it stays off the public internet
# when the optional Caddy profile is enabled.
PORT=14000
REDIS_ADDR=redis:6379
KEYBANK_STORE=redis
AUTO_HIDE_SECONDS=60
RATE_LIMIT_CREATE=30
RATE_LIMIT_FETCH=60
MAX_TTL=168h
# Trust X-Forwarded-For for per-client rate limiting behind the shipped Caddy
# proxy. Set false when exposing the app directly without a reverse proxy.
TRUST_XFF=true

# Deployment configuration
# Set this to the public DNS name that points at your VPS before enabling Caddy.
SITE_ADDRESS=notes.example.com

# Optional: uncomment to make `docker compose up -d` include Caddy by default.
# COMPOSE_PROFILES=caddy
